{
  "name": "Quickwords",
  "version": "v0.1.2",
  "description": "A productivity app, to get on with your work quicker",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "node node_modules/cross-env/dist/bin/cross-env.js NODE_ENV=development node_modules/webpack/bin/webpack.js --watch --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "prod": "node node_modules/cross-env/dist/bin/cross-env.js NODE_ENV=production node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "lint": "node_modules/.bin/eslint --ext .js,.vue src",
    "test": "mocha --recursive",
    "pack": "build --dir",
    "dist": "build"
  },
  "build": {
    "appId": "co.quickwords.quickwords",
    "productName": "Quickwords"
  },
  "repository": "https://github.com/electron/electron-quick-start",
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo"
  ],
  "author": "Dariusz Czajkowski and Grzegorz T\u0142uszcz",
  "license": "MIT",
  "devDependencies": {
    "@vue/devtools": "^1.1.0",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "glob-all": "^3.3.1",
    "laravel-mix": "^6.0.49",
    "mocha": "^10.7.3",
    "purgecss-webpack-plugin": "^7.0.2",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "brace": "^0.11.1",
    "electron": "26.6.10",
    "electron-is-dev": "^1.2.0",
    "electron-store": "^8.2.0",
    "fix-path": "^3.0.0",
    "lodash": "^4.17.21",
    "native-keymap": "3.3.9",
    "node-fetch": "^2.7.0",
    "robotjs": "0.9.1",
    "uiohook-napi": "1.5.5",
    "vue": "^2.7.16",
    "vue-emoji-picker": "^1.0.1",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2",
    "webpack-merge": "^5.10.0"
  },
  "engines": {
    "node": ">=18"
  }
}
